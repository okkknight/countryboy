{
  "manifest_version": 3,
  "name": "小镇做题家",
  "version": "0.1.1",
  "description": "截图识别题目，提供解题思路与参考答案。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.boringmax.com/countryboy/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "小镇做题家：识别并解题",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-v9.png",
      "32": "icons/icon32-v9.png",
      "48": "icons/icon48-v9.png",
      "128": "icons/icon128-v9.png"
    }
  },
  "icons": {
    "16": "icons/icon16-v9.png",
    "32": "icons/icon32-v9.png",
    "48": "icons/icon48-v9.png",
    "128": "icons/icon128-v9.png"
  }
}
